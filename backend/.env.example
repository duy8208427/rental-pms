DATABASE_URL=sqlite:///./rental_pms.db
# DATABASE_URL=postgresql+psycopg2://rental:rental@localhost:5432/rental_pms
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Public API base (webhook / sandbox pay URL)
PUBLIC_API_BASE=http://127.0.0.1:8000

# sandbox = mock gateway + /api/payments/sandbox/pay/{orderId}
# live = gọi MoMo / PayOS thật (cần key bên dưới)
PAYMENT_MODE=sandbox

# MoMo (sandbox: https://developers.momo.vn)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://127.0.0.1:8000/api/payments/return/momo
MOMO_IPN_URL=http://127.0.0.1:8000/api/webhooks/momo

# PayOS VietQR / chuyển khoản (https://payos.vn)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_ENDPOINT=https://api-merchant.payos.vn/v2/payment-requests
PAYOS_RETURN_URL=http://127.0.0.1:8000/api/payments/return/payos
PAYOS_CANCEL_URL=http://127.0.0.1:8000/api/payments/return/payos
PAYOS_WEBHOOK_URL=http://127.0.0.1:8000/api/webhooks/payos
